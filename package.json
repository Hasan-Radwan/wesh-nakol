{
  "name": "wesh-nakol",
  "version": "0.1.0",
  "private": true,
  "description": "وش ناكل؟ — قرار وجبة اليوم + تصويت عائلي (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:create": "wrangler d1 create wesh-nakol-db",
    "db:local": "wrangler d1 execute wesh-nakol-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute wesh-nakol-db --remote --file=schema.sql",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
